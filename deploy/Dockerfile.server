# syntax=docker/dockerfile:1.7

# ---- build: install workspace deps and bundle the server into a single file ----
FROM node:22-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

# Copy only manifests first so the dependency layer is cached until they change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/client/package.json apps/client/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @neon/server...

COPY packages/shared packages/shared
COPY apps/server apps/server
RUN pnpm --filter @neon/server build

# ---- runtime: Node + one bundled file. No node_modules, no package manager, non-root. ----
FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/server/dist/server.cjs ./server.cjs
USER node
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# `node` as PID 1 handles SIGTERM itself (graceful shutdown in src/index.ts);
# compose/Kubernetes also add an init (tini) if you prefer: docker run --init.
CMD ["node", "server.cjs"]
