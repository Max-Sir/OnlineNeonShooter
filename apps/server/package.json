{
  "name": "@neon/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative WebSocket game server",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/server.cjs",
    "bots": "tsx scripts/bots.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@neon/shared": "workspace:*",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
