# Copy to .env for local overrides. Never commit real secrets.

# --- Game server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Simulation ticks per second (clients and server must agree; sent in the welcome message).
TICK_RATE=30
# Send a world snapshot every N ticks (30 / 2 = 15 snapshots per second).
SNAPSHOT_DIVISOR=2
MAX_PLAYERS_PER_ROOM=16
MAX_ROOMS=20
# Simultaneous WebSocket connections allowed per client IP (households/schools share one IP).
MAX_CONNECTIONS_PER_IP=20
# Comma-separated list of allowed browser Origins for WebSocket upgrades.
# Empty = allow any origin (fine for local dev, NOT for production).
ALLOWED_ORIGINS=

# --- Docker compose ---
# Host port the web container is published on.
WEB_PORT=8080
